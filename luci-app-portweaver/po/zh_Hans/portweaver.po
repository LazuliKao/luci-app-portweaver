msgstr "端口映射"

msgid "Format: [listen_port][frp_node:port]...:target_port/protocol or listen_port[:target_port][/protocol]. Examples: \"[8080][node1:9888][node2:9999]:80/tcp\" (with FRP), \"8080-8090:80-90/udp\" (port range), \"[8080]:80/tcp\" (single port with FRP), \"443:8443/tcp\" (single port), \"80\" (defaults to tcp, target_port same as listen_port)"
msgstr "格式：[listen_port][frp_node:port]...:target_port/protocol 或 listen_port[:target_port][/protocol]。示例：\"[8080][node1:9888][node2:9999]:80/tcp\"（带 FRP）、\"8080-8090:80-90/udp\"（端口范围）、\"[8080]:80/tcp\"（单端口带 FRP）、\"443:8443/tcp\"（单端口）、\"80\"（默认 tcp，target_port 与 listen_port 相同）"

msgid "Invalid bracket format: unmatched \"[\" or \"]\"" 
msgstr "括号格式无效：\"[\"或\"]\"不匹配"

msgid "Invalid FRP node format: \""
msgstr "FRP 节点格式无效：\""

msgid ". Expected format: \"node_name:port\""
msgstr "。预期格式：\"node_name:port\""

msgid "Invalid listen port in brackets: \""
msgstr "括号内监听端口无效：\""

msgid "\". Must be a port number (1-65535) or range (e.g., \"8080-8090\")"
msgstr "\"。必须是端口号（1-65535）或范围（例如"8080-8090"）"

msgid "Listen port is required"
msgstr "监听端口为必填项"

msgid "Invalid listen port specification: \""
msgstr "监听端口格式无效：\""

msgid "Invalid target port specification: \""
msgstr "目标端口格式无效：\""

msgid ". Must be a port number (1-65535) or range (e.g., \"80-90\")"
msgstr "\"。必须是端口号（1-65535）或范围（例如"80-90"）"

msgid "Invalid format: too many \"/\" separators"
msgstr "格式无效：包含过多"/"分隔符"

msgid "Protocol cannot be empty"
msgstr "协议不能为空"

msgid "Protocol must be tcp, udp, or both"
msgstr "协议必须为 tcp、udp 或 both"

msgid "Port specification required"
msgstr "需要端口说明"

msgid "Invalid format: too many \":\" separators"
msgstr "格式无效：包含过多":"分隔符"

msgid "Invalid listen port specification. Must be a port number (1-65535) or range (e.g., \"8080-8090\")"
msgstr "监听端口格式无效。必须是端口号（1-65535）或范围（例如"8080-8090"）"

msgid "Invalid target port specification. Must be a port number (1-65535) or range (e.g., \"80-90\")"
msgstr "目标端口格式无效。必须是端口号（1-65535）或范围（例如"80-90"）"

msgid "When listen port is a range, target port must also be a range of the same size"
msgstr "当监听端口为范围时，目标端口也必须为相同大小的范围"

msgid "Invalid range specification"
msgstr "范围格式无效"

msgid "Port range size mismatch: the listen and target ranges must have the same size"
msgstr "端口范围大小不匹配：监听和目标范围必须具有相同大小"

msgid "When target port is a range, listen port must also be a range of the same size"
msgstr "当目标端口为范围时，监听端口也必须为相同大小的范围"

msgid "Source Zones"
msgstr "源区域"

msgid "Destination Zones"
msgstr "目标区域"

msgid "Open Firewall Port"
msgstr "打开防火墙端口"

msgid "Enable App Level Forward"
msgstr "启用应用级转发"

msgid "Reuse Address"
msgstr "重用地址"

msgid "Enable Statistics"
msgstr "启用统计"

msgid "Collect traffic statistics (bytes_in/bytes_out) using zero-cost atomic counters. NOTE: Mutually exclusive with firewall forwarding - enabling stats will disable add_firewall_forward."
msgstr "收集流量统计（bytes_in/bytes_out），使用零成本的原子计数器。注意：与防火墙转发互斥 - 启用统计将禁用 add_firewall_forward。"

msgid "Add Firewall Forward"
msgstr "添加防火墙转发"
